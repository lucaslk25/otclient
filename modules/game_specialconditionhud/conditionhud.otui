ConditionHUDIcon < UIWidget
  size: 20 20
  fixed-size: true
  opacity: 1.0
  text-align: center

ConditionHUDPanel < UIWidget
  id: conditionHUDPanel
  size: 24 50
  background-color: alpha
  focusable: false
  phantom: false
  overflow: visible

  UIWidget
    id: conditionHUDBox
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomResizeBorder.top
    background-color: #000000dd
    background-radius: 10
    focusable: false

    UIWidget
      id: iconsContainer
      phantom: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 3
      layout:
        type: verticalBox
        spacing: 5
        fit-children: false

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: orientationButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 3
    height: 4
    minimum: 24
    maximum: 400

  ResizeBorder
    id: rightResizeBorder
    anchors.right: orientationButton.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 3
    width: 4
    minimum: 40
    maximum: 400

  Button
    id: orientationButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 18
    height: 18
    margin: 3
    !text: tr('H/V')
    font: verdana-9px-bold
